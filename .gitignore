# Ignore all target folders in all modules
**/target/

# Allow the Maven Wrapper JAR
!.mvn/wrapper/maven-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# Logs
*.log

# OS-specific
.DS_Store
Thumbs.db

# Ignore compiled JARs if they accidentally land in root/module
*.jar
*.war
*.class

# VS Code (if used)
.vscode/
workspace/

# Local docker-compose testing (media-service, etc.) — stays local only, never tracked
local/
docker-compose.media-local.yml
docker-compose.media-local.env
docker-compose.media-local.env.example
media-service/LOCAL_TESTING.md
